# ═══════════════════════════════════════════════════════════════
# AGENTE CARMEN (Kiro SRE) - VARIABLES DE ENTORNO
# Copiar a .env y completar con tus credenciales
# ═══════════════════════════════════════════════════════════════

KIRO_ENVIRONMENT=dev
KIRO_DEBUG=false

# Modo de operación (true=mock sin AWS, false=Bedrock real)
KIRO_USE_MOCK_AWS=false

# AWS Credentials (requeridas cuando KIRO_USE_MOCK_AWS=false)
KIRO_AWS_ACCESS_KEY_ID=tu-access-key-aqui
KIRO_AWS_SECRET_ACCESS_KEY=tu-secret-key-aqui
# KIRO_AWS_SESSION_TOKEN=opcional-si-usas-sts

# AWS Config
KIRO_AWS_REGION=us-east-1

# Modelo Bedrock
#   us.amazon.nova-lite-v1:0                  → gratis en free tier (recomendado)
#   us.amazon.nova-pro-v1:0                   → mejor razonamiento, bajo costo
#   anthropic.claude-3-haiku-20240307-v1:0    → Claude barato
#   anthropic.claude-3-5-sonnet-20241022-v2:0 → Claude potente
KIRO_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# CloudWatch Logs - debe coincidir con LOG_GROUP_NAME del Backend
KIRO_LOG_GROUP_NAME=/kiro/microservices/backend

# DynamoDB Tables
KIRO_KNOWLEDGE_TABLE=kiro-dev-KnowledgeTable
KIRO_TICKETS_TABLE=kiro-dev-TicketsTable
KIRO_INCIDENTS_TABLE=kiro-dev-IncidentsTable
KIRO_AUDIT_TABLE=kiro-dev-AuditTable

# Audit trail: false hasta que las tablas DynamoDB existan (terraform apply)
KIRO_ENABLE_AUDIT_TRAIL=false

# EventBridge
KIRO_EVENT_BUS_NAME=kiro-monitor-events
