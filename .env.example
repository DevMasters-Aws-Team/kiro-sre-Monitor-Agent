# ══════════════════════════════════════════════════════════════════════
# Configuración del Agente SRE Autónomo
# ══════════════════════════════════════════════════════════════════════

KIRO_ENVIRONMENT=dev
KIRO_DEBUG=true

# ── Modelo LLM ──────────────────────────────────────────────────────
# Formato: provider:model_name
# Providers soportados:
#   ollama            → Modelo local (dev)
#   openai            → OpenAI API
#   azure_openai      → Azure OpenAI
#   bedrock_converse  → AWS Bedrock
#   google_genai      → Google AI (Gemini)
#   google_vertexai   → Google Vertex AI
#   anthropic         → Anthropic Claude directo
#   fireworks         → Fireworks AI
#   groq              → Groq
#
# Ejemplos:
#   KIRO_MODEL_ID=ollama:qwen3:8b
#   KIRO_MODEL_ID=openai:gpt-4o
#   KIRO_MODEL_ID=azure_openai:gpt-5.4-nano
#   KIRO_MODEL_ID=bedrock_converse:anthropic.claude-3-sonnet-20240229-v1:0
#   KIRO_MODEL_ID=google_genai:gemini-2.0-flash
KIRO_MODEL_ID=azure_openai:gpt-5.4-nano

# ── Azure OpenAI ────────────────────────────────────────────────────
# Si usas azure_openai como provider:
KIRO_AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
KIRO_AZURE_OPENAI_API_VERSION=2024-12-01-preview
KIRO_AZURE_DEPLOYMENT=gpt-5.4-nano
# true = usa Azure AD (az login), false = usa AZURE_OPENAI_API_KEY
KIRO_AZURE_USE_AD=true

# Si azure_use_ad=false, necesitas:
# AZURE_OPENAI_API_KEY=tu-api-key

# ── AWS Bedrock ─────────────────────────────────────────────────────
# Si usas bedrock_converse como provider:
KIRO_AWS_REGION=us-east-1
# Autenticación via AWS CLI (aws configure) o variables:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── OpenAI ──────────────────────────────────────────────────────────
# Si usas openai como provider:
# OPENAI_API_KEY=sk-...

# ── Google ──────────────────────────────────────────────────────────
# Si usas google_genai:
# GOOGLE_API_KEY=...
# Si usas google_vertexai:
# KIRO_GCP_PROJECT=tu-proyecto
# KIRO_GCP_LOCATION=us-central1

# ── DynamoDB ────────────────────────────────────────────────────────
KIRO_KNOWLEDGE_TABLE=KnowledgeTable
KIRO_TICKETS_TABLE=TicketsTable
KIRO_INCIDENTS_TABLE=IncidentsTable
KIRO_AUDIT_TABLE=AuditTable
KIRO_EVENT_BUS_NAME=kiro-monitor-events
